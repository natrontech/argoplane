{
	"name": "docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "npx pagefind --site build --output-path build/pagefind",
		"search:index": "vite build && npx pagefind --site build --output-path static/pagefind",
		"preview": "npx sirv build --single --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"mdsvex": "^0.12.8",
		"pagefind": "^1.5.2",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.5.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"lucide-svelte": "^1.0.1"
	}
}
